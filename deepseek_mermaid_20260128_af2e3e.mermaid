flowchart TD
    subgraph A[Input Layer: In-Vehicle Gateway or Domain Controller]
        CAN[CAN or CAN-FD Frames<br>In-vehicle control traffic]
        Eth[Automotive Ethernet Frames<br>SOME/IP and packet metadata]
    end

    subgraph B[Preprocessing and Cross-Protocol Alignment]
        CAN --> CANFeat[CAN Feature Engineering<br>10 raw + 6 engineered features]
        Eth --> EthFeat[Ethernet Encoding<br>32x32 grayscale packet image]
        CANFeat --> Align[CAN-ETH Correlation Engine<br>Timestamp and session alignment<br>100 CAN messages + 1 ETH frame]
        EthFeat --> Align
    end

    subgraph C[Lightweight Hybrid Detector]
        Align --> CANBranch[CAN Branch<br>Depthwise-Separable TCN]
        Align --> EthBranch[ETH Branch<br>Compact CNN]
        CANBranch --> Fusion[Concat Fusion + MLP Classifier]
        EthBranch --> Fusion
        Fusion --> LightModel[TinyHybridStudent<br>ONNX Runtime or PyTorch<br>Edge-first inference]
    end

    subgraph D[Confidence-Gated Cascade]
        LightModel --> Decision{Softmax confidence<br>below threshold?}
        Decision -- No --> AlertFast[Final Alert<br>Normal or Malicious]
        Decision -- Yes --> HeavyModel[Heavy Fallback Tier<br>Random Forest on flattened<br>CAN + ETH features]
        HeavyModel --> AlertHeavy[Final Alert<br>Normal or Malicious]
    end

    subgraph E[Runtime Output and Validation]
        AlertFast --> Metrics[Alert log and runtime metrics<br>Latency, FPR, FNR, MCC,<br>deadline miss rate]
        AlertHeavy --> Metrics
    end
